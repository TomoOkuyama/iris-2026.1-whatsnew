{
  "realm": "iris-demo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "eventsEnabled": true,
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "TOKEN_EXCHANGE", "CLIENT_LOGIN", "CLIENT_LOGIN_ERROR"],
  "eventsExpiration": 86400,
  "adminEventsEnabled": true,
  "clients": [
    {
      "clientId": "iris-client",
      "name": "IRIS Demo Client",
      "enabled": true,
      "publicClient": false,
      "secret": "iris-demo-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "email": "testuser@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "testpass",
          "temporary": false
        }
      ]
    }
  ]
}
